/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://north3rnlight3r.com https://www.north3rnlight3r.com; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' https://fonts.googleapis.com; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/ops
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive

/ops.js
  Cache-Control: no-store

/ops.css
  Cache-Control: no-store

/assets/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/showcase/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/docs/*
  Cache-Control: public, max-age=3600, must-revalidate

/app.js
  Cache-Control: public, max-age=3600, must-revalidate

/config.js
  Cache-Control: public, max-age=300, must-revalidate

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/audio/catalog/*
  Cache-Control: public, max-age=31536000, immutable

/assets/data/*
  Cache-Control: no-store

/api/*
  Cache-Control: no-store

/v1/*
  Cache-Control: no-store

/health
  Cache-Control: no-store
