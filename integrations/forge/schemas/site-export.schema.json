{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.north3rnlight3r.com/schemas/site-export.schema.json",
  "type": "object",
  "required": ["schemaVersion", "exportType", "generatedAt", "timeZone", "summary", "siteAnalytics", "downloads", "sessions", "inquiries", "errors", "apiActivity", "deployment"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "exportType": { "const": "aifred.site-data" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timeZone": { "const": "UTC" },
    "summary": { "type": "object" },
    "siteAnalytics": { "type": "object" },
    "downloads": { "type": "array" },
    "sessions": { "type": "array", "items": { "type": "string" } },
    "inquiries": { "type": "array" },
    "errors": { "type": "array" },
    "apiActivity": { "type": "array" },
    "deployment": { "type": "object" }
  }
}
