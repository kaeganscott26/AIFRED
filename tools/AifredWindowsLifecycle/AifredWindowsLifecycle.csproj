<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LifecycleMode Condition="'$(LifecycleMode)' == ''">Setup</LifecycleMode>
    <AssemblyName Condition="'$(AssemblyName)' == ''">AIFRED-Beta-Setup</AssemblyName>
    <Version Condition="'$(Version)' == ''">0.4.0</Version>
    <DefineConstants>$(DefineConstants);AIFRED_$([System.String]::Copy('$(LifecycleMode)').ToUpperInvariant())</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifecycleMode)' == 'Setup'">
    <AifredPayloadPath Condition="'$(AifredPayloadPath)' == ''">$(MSBuildThisFileDirectory)../../out/windows-x64/build/packaging/payload.zip</AifredPayloadPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(LifecycleMode)' == 'Setup'">
    <EmbeddedResource Include="$(AifredPayloadPath)" LogicalName="AIFRED.Beta.Payload.zip" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../plugin-aifred/Assets/aifred-mascot.jpg" LogicalName="AIFRED.Brand.Mascot.jpg" />
  </ItemGroup>
</Project>
