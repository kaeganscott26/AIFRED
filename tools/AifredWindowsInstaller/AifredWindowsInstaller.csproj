<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIFRED-VST3-Setup</AssemblyName>
    <RootNamespace>AifredWindowsInstaller</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <AifredPackagePath Condition="'$(AifredPackagePath)' == ''">$(MSBuildThisFileDirectory)../../out/windows-x64/stage/AIFRED-VST3-windows.zip</AifredPackagePath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(AifredPackagePath)" LogicalName="AIFRED-VST3-windows.zip" />
  </ItemGroup>
  <ItemGroup><Compile Include="../WindowsInstallOwnership.cs" Link="WindowsInstallOwnership.cs" /></ItemGroup>
</Project>
